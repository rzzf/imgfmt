{
  "name": "imgfmt",
  "version": "0.0.0",
  "description": "Exact-one delivery of user-provided CSS image format variants.",
  "keywords": [
    "avif",
    "css",
    "esbuild",
    "image",
    "postcss",
    "rolldown",
    "rollup",
    "rspack",
    "unplugin",
    "vite",
    "webp",
    "webpack"
  ],
  "homepage": "https://github.com/rzzf/imgfmt#readme",
  "bugs": {
    "url": "https://github.com/rzzf/imgfmt/issues"
  },
  "license": "MIT",
  "author": "rzzf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzzf/imgfmt.git",
    "directory": "packages/imgfmt"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "module-sync": "./dist/postcss.js",
      "default": "./dist/postcss.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "module-sync": "./dist/esbuild.js",
      "default": "./dist/esbuild.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "module-sync": "./dist/rolldown.js",
      "default": "./dist/rolldown.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "module-sync": "./dist/rollup.js",
      "default": "./dist/rollup.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "module-sync": "./dist/rspack.js",
      "default": "./dist/rspack.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "module-sync": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "module-sync": "./dist/webpack.js",
      "default": "./dist/webpack.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/postcss.ts src/vite.ts src/rollup.ts src/rolldown.ts src/webpack.ts src/rspack.ts src/esbuild.ts --dts"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-html": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "catalog:",
    "css-loader": "catalog:",
    "esbuild": "catalog:",
    "html-webpack-plugin": "catalog:",
    "mini-css-extract-plugin": "catalog:",
    "postcss": "catalog:",
    "postcss-loader": "catalog:",
    "rolldown": "catalog:",
    "rollup": "catalog:",
    "vite-official": "catalog:",
    "webpack": "catalog:"
  },
  "peerDependencies": {
    "@rspack/core": "^2.1.5",
    "esbuild": "^0.28.1",
    "html-webpack-plugin": "^5.6.7",
    "postcss": "^8.4.31",
    "rolldown": "^1.2.0",
    "rollup": "^4.62.2",
    "vite": "^8.1.5",
    "webpack": "^5.109.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "html-webpack-plugin": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
