{
  "name": "imgfmt",
  "version": "0.0.0",
  "private": true,
  "description": "Exact-one delivery of user-provided CSS image format variants.",
  "keywords": [
    "avif",
    "css",
    "image",
    "parcel",
    "postcss",
    "unplugin",
    "vite",
    "webp"
  ],
  "homepage": "https://github.com/rzzf/imgfmt#readme",
  "bugs": {
    "url": "https://github.com/rzzf/imgfmt/issues"
  },
  "license": "MIT",
  "author": "rzzf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzzf/imgfmt.git",
    "directory": "packages/imgfmt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts --dts"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
