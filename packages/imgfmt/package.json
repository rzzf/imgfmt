{
  "name": "imgfmt",
  "version": "0.0.0",
  "private": true,
  "description": "Exact-one delivery of user-provided CSS image format variants.",
  "keywords": [
    "avif",
    "css",
    "image",
    "parcel",
    "postcss",
    "unplugin",
    "vite",
    "webp"
  ],
  "homepage": "https://github.com/rzzf/imgfmt#readme",
  "bugs": {
    "url": "https://github.com/rzzf/imgfmt/issues"
  },
  "license": "MIT",
  "author": "rzzf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzzf/imgfmt.git",
    "directory": "packages/imgfmt"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "module-sync": "./dist/postcss.js",
      "default": "./dist/postcss.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "module-sync": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/postcss.ts src/vite.ts --dts"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "postcss": "catalog:",
    "vite-official": "catalog:"
  },
  "peerDependencies": {
    "postcss": "^8.4.31"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
